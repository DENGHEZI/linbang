{
	"bsonType": "object",
	"required": [
		"user_id",
		"session_id",
		"messages",
		"created_at",
		"updated_at"
	],
	"permission": {
		"read": "doc.user_id == auth.uid",
		"create": true,
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"user_id": {
			"bsonType": "string",
			"description": "用户ID",
			"foreignKey": "uni-id-users._id"
		},
		"session_id": {
			"bsonType": "string",
			"description": "会话ID",
			"maxLength": 64
		},
		"order_id": {
			"bsonType": "string",
			"description": "关联订单ID（可选）",
			"foreignKey": "order._id",
			"defaultValue": null
		},
		"messages": {
			"bsonType": "array",
			"description": "对话消息列表",
			"items": {
				"bsonType": "object",
				"properties": {
					"role": {
						"bsonType": "string",
						"description": "角色",
						"enum": [
							{ "value": "user", "text": "用户" },
							{ "value": "ai", "text": "AI客服" },
							{ "value": "system", "text": "系统" }
						]
					},
					"content": {
						"bsonType": "string",
						"description": "消息内容",
						"maxLength": 1000
					},
					"timestamp": {
						"bsonType": "timestamp",
						"description": "消息时间"
					},
					"intent": {
						"bsonType": "string",
						"description": "识别的意图",
						"defaultValue": ""
					}
				}
			}
		},
		"message_count": {
			"bsonType": "int",
			"description": "消息总数",
			"defaultValue": 0
		},
		"status": {
			"bsonType": "string",
			"description": "会话状态",
			"enum": [
				{ "value": "active", "text": "进行中" },
				{ "value": "resolved", "text": "已解决" },
				{ "value": "transferred", "text": "已转人工" }
			],
			"defaultValue": "active"
		},
		"created_at": {
			"bsonType": "timestamp",
			"description": "创建时间"
		},
		"updated_at": {
			"bsonType": "timestamp",
			"description": "更新时间"
		}
	}
}
